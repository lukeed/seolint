{
  "type": "module",
  "version": "1.0.0",
  "name": "seolint",
  "repository": "lukeed/seolint",
  "homepage": "https://seolint.io",
  "description": "A robust and configurable SEO linter",
  "license": "MIT",
  "author": {
    "name": "Luke Edwards",
    "email": "luke.edwards05@gmail.com",
    "url": "https://lukeed.com"
  },
  "contributors": [
    {
      "name": "Nick Reese",
      "url": "https://elderguide.com"
    }
  ],
  "scripts": {
    "build": "bun build.ts",
    "example": "bun run --cwd example",
    "bench": "bun run --cwd bench",
    "www": "bun run --cwd www"
  },
  "bin": "dist/bin.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.8"
  },
  "keywords": [],
  "dependencies": {
    "@lukeed/html": "^1.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "bench",
    "example",
    "www"
  ]
}
