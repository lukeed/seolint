{
  "name": "seolint",
  "version": "1.0.0-next.1",
  "repository": "lukeed/seolint",
  "description": "A robust and configurable SEO linter",
  "type": "module",
  "license": "MIT",
  "bin": "dist/bin.js",
  "author": "Nick Reese (https://elderguide.com)",
  "contributors": [
    "Luke Edwards <luke.edwards05@gmail.com> (https://lukeed.com)"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts src/bin.ts --outdir dist --target node --packages external --splitting --minify",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@lukeed/html": "^0.0.0"
  },
  "keywords": [],
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
