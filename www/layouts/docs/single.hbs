{{#var sections = $page.headings.filter(h => h.level === 2 && h.id !== "contents")}}
<div class="wrap docs">
	<aside class="side">
		<p class="label">Docs</p>
		<a href="/docs/rules/"{{#if $page.path === "/docs/rules/"}} aria-current="page"{{/if}}>Rules</a>
		<a href="/docs/presets/"{{#if $page.path === "/docs/presets/"}} aria-current="page"{{/if}}>Presets</a>
		<p class="label">On this page</p>
		{{#each sections as h}}
		<a class="toc" href="#{{ h.id }}">{{{ h.html }}}</a>
		{{/each}}
	</aside>
	<article class="prose">
		{{{ $page.content }}}
	</article>
</div>
