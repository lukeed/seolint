{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "seolint-www",
	"compatibility_date": "2026-10-27",
	"assets": {
		"directory": "./public",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
	},
	"routes": [
		{
			"pattern": "seolint.io",
			"custom_domain": true,
		},
	],
}
