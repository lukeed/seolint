{
  "compilerOptions": {
    "strict": true,
    "target": "es2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["bun"],
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "seolint": ["./src/index.ts"],
      "seolint/config": ["./src/config.ts"]
    }
  },
  "include": ["src", "build.ts", "example/seolint.config.ts"]
}
